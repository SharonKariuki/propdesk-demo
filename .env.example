# PropDesk demo — configuration. Copy to .env.local only if you need to change
# something; with no .env at all the app runs on its built-in demo data.

# Which data provider the UI talks to:
#   local (default) — synthetic data, answered and stored inside the browser.
#   http            — a real backend at VITE_API_BASE_URL.
VITE_DATA_PROVIDER=local

# Only read when VITE_DATA_PROVIDER=http. Must end in the API root, e.g. /api.
VITE_API_BASE_URL=

# Local provider only: simulated network delay (ms) so loading states show.
VITE_LOCAL_LATENCY_MS=250

# Local provider only: share (0–1) of GET requests that fail on purpose, to
# exercise error states. Keep 0 for normal use.
VITE_LOCAL_FAILURE_RATE=0
